# DBGuard base MySQL config (docs/INTERFACES.md "my.cnf"). Installed as
# /etc/mysql/conf.d/dbguard-base.cnf. The per-node values (server_id, report_host) are
# rendered from env by /entrypoint.sh into /etc/mysql/conf.d/dbguard-node.cnf.
#
# Datadir (and the binlog in it) is a plain named volume. For the disk-full scenario only,
# deploy/compose.diskfull.yml recreates mysql-a1 with DBGUARD_BINLOG_DIR on a 256 MB tmpfs,
# and /entrypoint.sh renders log_bin/log_bin_index into dbguard-node.cnf, which overrides
# the line below. See docs/INTERFACES.md "disk-full".
[mysqld]
bind_address=0.0.0.0
port=3306
skip_name_resolve=ON
mysqlx=0

# GTID and binlog
gtid_mode=ON
enforce_gtid_consistency=ON
log_bin=binlog
log_replica_updates=ON
binlog_format=ROW
binlog_expire_logs_seconds=3600
sync_binlog=1
innodb_flush_log_at_trx_commit=1
relay_log=relay-bin
relay_log_recovery=ON

# Every node boots read-only. Only promotion clears it.
super_read_only=ON
read_only=ON

# Plugins. One line per plugin (a ';' list is also valid, but keep it obvious).
plugin_load_add=semisync_source.so
plugin_load_add=semisync_replica.so
plugin_load_add=mysql_clone.so

# Semi-sync tuning. loose_ because mysqld --initialize ignores plugin_load_add and would
# abort on an unknown variable. bin/bootstrap and the agent verify the plugin is ACTIVE.
# Semi-sync tuning. The *_enabled switches are set at runtime by the agent (or bin/bootstrap)
# per role. Naive mode (DBGUARD_SEMISYNC=0) loads the plugins but never enables them.
loose_rpl_semi_sync_source_wait_point=AFTER_SYNC
loose_rpl_semi_sync_source_wait_for_replica_count=1
loose_rpl_semi_sync_source_timeout=3600000

# Applier parallelism. With the 8.4 default of 4 workers the replicas applied about 70% of
# what 8 workload clients commit and fell 44 s behind in 5 minutes. 16 kept lag at 0 to 1 s
# but pushed replicas to the 700 MiB limit and got mysqld OOM-killed during START REPLICA.
# 8 is the compromise (docs/BUGS.md). Dependencies come from WRITESET, commit order is kept.
replica_parallel_workers=8
replica_preserve_commit_order=ON

# IO thread notices a dead source in about 2 s instead of 60 s.
replica_net_timeout=2

# Memory. mem_limit is 1g per node. Seven nodes plus haproxy, manager and Orchestrator must
# fit in Docker Desktop's 7.7 GB, and no node may reach its own limit (docs/BUGS.md).
innodb_buffer_pool_size=128M
innodb_redo_log_capacity=128M
innodb_log_buffer_size=8M
tmp_table_size=16M
max_heap_table_size=16M
max_connections=120
# performance_schema stays ON: the agent reads performance_schema.threads and clone_progress.
performance_schema=ON
performance-schema-instrument='wait/%=OFF'

