# /etc/dbguard/agent.env on a MySQL host
DBGUARD_NODE=mysql-a1
DBGUARD_RS=rs1
DBGUARD_SERVER_ID=11
DBGUARD_SEMISYNC=1
DBGUARD_MANAGER_URL=http://dbguard-manager.internal:9090
DBGUARD_MYSQLD_CMD=/usr/sbin/mysqld --user=mysql
MYSQL_ROOT_PASSWORD=change-me
# Optional shared token for the agent API (docs/INTERFACES.md). Empty or unset: auth off.
# Set, every route but GET /health, /metrics and /primary needs "Authorization: Bearer <token>",
# and the manager must be given the same value (dbguard.env or fleet.yaml agent_token).
DBGUARD_AGENT_TOKEN=
