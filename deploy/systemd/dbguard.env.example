# /etc/dbguard/dbguard.env on the manager host
DBGUARD_CONFIG=/etc/dbguard/fleet.yaml
DBGUARD_LISTEN=0.0.0.0:9090
# null: log a replacement request instead of calling docker compose (no allocator here)
DBGUARD_PROVISION=null
# Token the manager sends to every agent as "Authorization: Bearer <token>". Must match the
# agents' DBGUARD_AGENT_TOKEN. Non-empty here wins over agent_token in fleet.yaml. Empty: off.
DBGUARD_AGENT_TOKEN=
