# Copy to deploy/.env (or export in the shell) to choose the fleet flavour.
# Default: the DBGuard fleet, semi-sync AFTER_SYNC on, manager in dbguard mode.
DBGUARD_SEMISYNC=1
DBGUARD_MODE=dbguard
# Naive baseline (asynchronous replication, the manager promotes without fence or subset
# check). Equivalent to `make up-naive`:
# DBGUARD_SEMISYNC=0
# DBGUARD_MODE=naive
